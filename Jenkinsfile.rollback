
pipeline {
    agent {
        label 'docker-lab'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    parameters {
        string(
            name: 'ROLLBACK_IMAGE',
            defaultValue: '',
            description: 'Например: django-stack-ci:11'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Image') {
            steps {
                script {
                    def image = params.ROLLBACK_IMAGE

                    if (!(image ==~ /^django-stack-ci:[0-9]+$/)) {
                        error("Invalid rollback image")
                    }

                    echo "Rollback target: ${image}"
                }

                sh '''
                    set -eu
                    docker image inspect "$ROLLBACK_IMAGE" \
                        >/dev/null

                    echo "Rollback image found"
                '''
            }
        }

        stage('Approve Rollback') {
            input {
                message 'Restore previous staging version?'
                ok 'Rollback'
            }

            steps {
                echo 'Rollback approved'
            }
        }

        stage('Rollback Staging') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'staging-db-password',
                        variable: 'DB_PASSWORD'
                    ),
                    string(
                        credentialsId: 'staging-django-secret',
                        variable: 'DJANGO_SECRET_KEY'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        export CI_IMAGE="$ROLLBACK_IMAGE"

                        ansible-playbook \
                          -i automation/inventory.ini \
                          automation/rollback-staging.yml
                    '''
                }
            }
        }

        stage('Verify Version') {
            steps {
                sh '''
                    set -eu

                    curl -fsS \
                      http://127.0.0.1:8900/

                    docker ps \
                      --filter label=com.docker.compose.project=django-ci-staging \
                      --filter label=com.docker.compose.service=app \
                      --format '{{.Image}}'
                '''
            }
        }
    }

    post {
        success {
            echo 'STAGING ROLLBACK SUCCESS'
        }

        failure {
            echo 'STAGING ROLLBACK FAILED'
        }
    }
}
